# WeatherGPT Root Environment Template

# Project Settings
PROJECT_NAME="WeatherGPT Backend"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000
DEBUG=True

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=weathergpt
DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password@localhost:5432/weathergpt

# Redis Cache & PubSub
REDIS_URL=redis://localhost:6379/0

# LLM Providers (Google Gemini & Sarvam AI)
DEFAULT_LLM_PROVIDER=gemini # 'gemini' or 'sarvam'
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
SARVAM_API_KEY=your_sarvam_api_key_here

# Weather & Geocoding External APIs (Open-Meteo)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1
WEATHERAPI_KEY=your_weatherapi_key_optional

# Supabase Auth & Cloud Database
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Severe Weather Alerts Configuration
OFFICIAL_ALERT_IDENTIFIER=
ALERT_POLL_INTERVAL_SECONDS=300
