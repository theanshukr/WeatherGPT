# WeatherGPT Environment Configuration

# Backend Service Settings
SERVICE_NAME=weathergpt-backend
SERVICE_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=False
PORT=8000
HOST=0.0.0.0

# Open-Meteo Integration Endpoints
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation

# Commercial API Key (optional, leave empty for standard open access)
OPEN_METEO_API_KEY=

# HTTP Resilience & Timeout Policies
REQUEST_TIMEOUT_SECONDS=10.0
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=0.5

# Flutter Mobile & Web Client Endpoints
DEV_BASE_URL=http://10.0.2.2:8000/api/v1
WEB_BASE_URL=http://localhost:8000/api/v1
WS_BASE_URL=ws://10.0.2.2:8000/ws
