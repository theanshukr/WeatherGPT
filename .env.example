# Server Configuration
PROJECT_NAME="WeatherGPT Backend"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000
DEBUG=True

# Database Configuration (PostgreSQL + pgvector / PostGIS)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=weathergpt
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/weathergpt

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# LLM Providers Configuration
DEFAULT_LLM_PROVIDER=gemini # Options: gemini, sarvam, mock
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-lite

SARVAM_API_KEY=your_sarvam_api_key_here

# Weather API Sources
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1

# Official Alert Source (NDMA SACHET CAP feed) — OPTIONAL
# Leave unset unless you've registered as a consuming agency with NDMA/C-DOT
# and obtained a real identifier. Without it, severe weather alerts are
# computed from forecast thresholds only (clearly labeled as such, not
# presented as official government warnings). See
# backend/app/services/alerts/official_alert_client.py for details.
OFFICIAL_ALERT_IDENTIFIER=
ALERT_POLL_INTERVAL_SECONDS=300
